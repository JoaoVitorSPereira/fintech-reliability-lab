{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@expo/ui": "~58.0.26",
    "@hookform/resolvers": "^7.0.1",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
