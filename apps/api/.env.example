NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://fintech:fintech@localhost:5433/fintech
REDIS_URL=redis://localhost:6379
GRAPHQL_MAX_DEPTH=8
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef

# Market data (all free). Never commit real keys.
MARKET_INGESTION_ENABLED=true
# Optional: CoinGecko demo key raises the public rate limit.
COINGECKO_DEMO_API_KEY=
# Optional: free key from twelvedata.com. Without it only AAPL is available.
TWELVE_DATA_API_KEY=
STOCK_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,SPY,QQQ
CRYPTO_LISTING_SIZE=25
