generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Nest 12 apps compile to CommonJS; Prisma 7 defaults to ESM output.
  moduleFormat        = "cjs"
  // Extensionless relative imports: valid for CJS under nodenext, and Jest can resolve them.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// UUIDv7 ids are time-ordered: new rows land at the end of the btree index
// instead of random pages, which keeps inserts cheap as tables grow.

model User {
  id           String           @id @default(uuid(7)) @db.Uuid
  /// Always lowercase; enforced by a CHECK constraint in the migration.
  email        String           @unique
  passwordHash String           @map("password_hash")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  accounts     Account[]
  transfers    Transfer[]
  portfolio    Portfolio?
  orders       SimulatedOrder[]
  watchlist    WatchlistItem[]

  @@map("users")
}

enum SessionRevocationReason {
  LOGOUT
  USER_REVOKED
  REFRESH_TOKEN_REUSE

  @@map("session_revocation_reason")
}

/// One login on one device. Refresh tokens rotate inside it.
model Session {
  id              String                   @id @default(uuid(7)) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  user            User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceName      String?                  @map("device_name")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastRefreshedAt DateTime?                @map("last_refreshed_at") @db.Timestamptz(3)
  /// Absolute lifetime: rotation never extends a session past this.
  expiresAt       DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason   SessionRevocationReason? @map("revoked_reason")
  refreshTokens   RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Only the SHA-256 of the token is stored. A database leak doesn't leak
/// usable tokens. Rows are kept after use so reuse can be detected.
model RefreshToken {
  id           String        @id @default(uuid(7)) @db.Uuid
  sessionId    String        @map("session_id") @db.Uuid
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tokenHash    String        @unique @map("token_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  /// Set when exchanged for a successor.
  rotatedAt    DateTime?     @map("rotated_at") @db.Timestamptz(3)
  /// Set when invalidated without being exchanged (grace re-issue, logout).
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(3)
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces     RefreshToken? @relation("Rotation")

  @@index([sessionId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Ledger (Milestone 3). Money is BIGINT minor units (centavos for BRL).
// The database enforces the invariants with triggers and constraints declared
// in the migration SQL; see docs/adr/0005-double-entry-ledger.md.
// ---------------------------------------------------------------------------

enum AccountKind {
  /// Owned by a user. Can never go negative (CHECK constraint).
  CUSTOMER
  /// Owned by the platform, e.g. "money that entered from outside". May go negative.
  SYSTEM

  @@map("account_kind")
}

enum AccountPurpose {
  /// The user's banking account (BRL).
  CHECKING
  /// Paper-trading cash available to spend (USD).
  PORTFOLIO_CASH
  /// Paper-trading cash held for open limit buy orders (USD).
  PORTFOLIO_RESERVED

  @@map("account_purpose")
}

model Account {
  id         String          @id @default(uuid(7)) @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  user       User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind       AccountKind
  /// Null for system accounts.
  purpose    AccountPurpose?
  /// Stable name for system accounts, e.g. "external-funding:BRL".
  systemCode String?         @unique @map("system_code")
  currency   String          @db.Char(3)
  /// Cached SUM(ledger_entries.amount). Maintained only by a trigger.
  balance    BigInt          @default(0)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  entries    LedgerEntry[]
  outgoing   Transfer[]      @relation("TransferFrom")
  incoming   Transfer[]      @relation("TransferTo")
  cashOf     Portfolio?      @relation("PortfolioCash")
  reservedOf Portfolio?      @relation("PortfolioReserved")

  /// Target of the composite FK that stops an entry's currency differing from its account's.
  @@unique([id, currency])
  @@index([userId])
  @@map("accounts")
}

enum LedgerTransactionKind {
  DEPOSIT
  TRANSFER
  /// Simulated trade settlement (cash <-> simulated market).
  TRADE
  /// Cash moved into / out of the reserved account for a limit buy.
  ORDER_HOLD
  ORDER_RELEASE

  @@map("ledger_transaction_kind")
}

/// One movement of money. Its entries must sum to zero per currency (checked at COMMIT).
model LedgerTransaction {
  id          String                @id @default(uuid(7)) @db.Uuid
  kind        LedgerTransactionKind
  description String
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  entries     LedgerEntry[]
  transfer    Transfer?
  trade       Trade?

  @@map("ledger_transactions")
}

/// Immutable. Positive amount = money into the account.
model LedgerEntry {
  id            String            @id @default(uuid(7)) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String            @map("account_id") @db.Uuid
  currency      String            @db.Char(3)
  account       Account           @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)
  amount        BigInt
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Statement pagination: WHERE account_id = $1 AND id < $cursor ORDER BY id DESC.
  @@index([accountId, id])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Transfers (Milestone 4). The business record of a money movement and its
// idempotency claim. The money itself is in the ledger transaction it points to.
// ---------------------------------------------------------------------------

enum TransferKind {
  /// Between two customer accounts.
  TRANSFER
  /// Simulated money in from outside (no real payment rail).
  SIMULATED_DEPOSIT

  @@map("transfer_kind")
}

/// Immutable audit record. One row per successful request.
model Transfer {
  id                  String            @id @default(uuid(7)) @db.Uuid
  /// Who asked for it. Idempotency keys are scoped per user.
  userId              String            @map("user_id") @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind                TransferKind
  idempotencyKey      String            @map("idempotency_key")
  /// SHA-256 of the canonical request. Same key + different request = error.
  requestHash         String            @map("request_hash")
  fromAccountId       String            @map("from_account_id") @db.Uuid
  fromAccount         Account           @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId         String            @map("to_account_id") @db.Uuid
  toAccount           Account           @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount              BigInt
  currency            String            @db.Char(3)
  description         String
  ledgerTransactionId String            @unique @map("ledger_transaction_id") @db.Uuid
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  /// Request id of the HTTP call that created it, for tracing across logs.
  correlationId       String?           @map("correlation_id")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, idempotencyKey])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

// ---------------------------------------------------------------------------
// Market data (Milestones 5-6). Prices are NUMERIC and travel as strings:
// provider precision is kept, nothing is ever a float in our code.
// Current quotes live in Redis (short-lived); candles are persisted here.
// ---------------------------------------------------------------------------

enum AssetCategory {
  CRYPTO
  STOCK
  /// Exchange-traded funds. SPY/QQQ stand in for the S&P 500 / Nasdaq-100 indices.
  ETF

  @@map("asset_category")
}

model Asset {
  id               String           @id @default(uuid(7)) @db.Uuid
  category         AssetCategory
  symbol           String
  name             String
  /// Currency prices are quoted in (USD; Binance pairs quote in USDT, see ADR 0007).
  quoteCurrency    String           @map("quote_currency")
  logoUrl          String?          @map("logo_url")
  marketCapRank    Int?             @map("market_cap_rank")
  /// Provider identifiers. Null = that provider doesn't cover this asset.
  coingeckoId      String?          @unique @map("coingecko_id")
  binanceSymbol    String?          @unique @map("binance_symbol")
  twelveDataSymbol String?          @unique @map("twelve_data_symbol")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  candles          Candle[]
  positions        Position[]
  orders           SimulatedOrder[]
  trades           Trade[]
  watchers         WatchlistItem[]

  @@unique([category, symbol])
  @@map("assets")
}

enum ChartTimeframe {
  M1
  M5
  M15
  H1
  H4
  D1
  W1
  MN1

  @@map("chart_timeframe")
}

/// OHLCV bar as reported by the provider. Times are UTC. Gaps are kept as gaps.
model Candle {
  assetId   String         @map("asset_id") @db.Uuid
  asset     Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timeframe ChartTimeframe
  openTime  DateTime       @map("open_time") @db.Timestamptz(3)
  open      Decimal        @db.Decimal(38, 12)
  high      Decimal        @db.Decimal(38, 12)
  low       Decimal        @db.Decimal(38, 12)
  close     Decimal        @db.Decimal(38, 12)
  volume    Decimal        @db.Decimal(38, 12)
  provider  String
  fetchedAt DateTime       @map("fetched_at") @db.Timestamptz(3)

  @@id([assetId, timeframe, openTime])
  @@map("candles")
}

// ---------------------------------------------------------------------------
// Paper trading (Milestone 7). SIMULATED: no exchange, no real orders.
// Cash moves through the ledger; positions are NUMERIC quantities.
// ---------------------------------------------------------------------------

model Portfolio {
  id                String               @id @default(uuid(7)) @db.Uuid
  userId            String               @unique @map("user_id") @db.Uuid
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  cashAccountId     String               @unique @map("cash_account_id") @db.Uuid
  cashAccount       Account              @relation("PortfolioCash", fields: [cashAccountId], references: [id], onDelete: Restrict)
  reservedAccountId String               @unique @map("reserved_account_id") @db.Uuid
  reservedAccount   Account              @relation("PortfolioReserved", fields: [reservedAccountId], references: [id], onDelete: Restrict)
  /// Incremented on every order/position change; used as the event sequence (Milestone 8).
  version           Int                  @default(0)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  positions         Position[]
  orders            SimulatedOrder[]
  trades            Trade[]
  valuations        PortfolioValuation[]

  @@map("portfolios")
}

model Position {
  portfolioId      String    @map("portfolio_id") @db.Uuid
  portfolio        Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  assetId          String    @map("asset_id") @db.Uuid
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  quantity         Decimal   @db.Decimal(38, 18)
  /// Held for open limit sell orders. Never more than quantity.
  reservedQuantity Decimal   @default(0) @map("reserved_quantity") @db.Decimal(38, 18)
  /// Total USD paid for the units still held (average cost method).
  costBasis        Decimal   @map("cost_basis") @db.Decimal(38, 8)
  realizedPnl      Decimal   @default(0) @map("realized_pnl") @db.Decimal(38, 8)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([portfolioId, assetId])
  @@map("positions")
}

enum OrderSide {
  BUY
  SELL

  @@map("order_side")
}

enum OrderType {
  MARKET
  LIMIT

  @@map("order_type")
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED

  @@map("order_status")
}

model SimulatedOrder {
  id                String      @id @default(uuid(7)) @db.Uuid
  portfolioId       String      @map("portfolio_id") @db.Uuid
  portfolio         Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  userId            String      @map("user_id") @db.Uuid
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  assetId           String      @map("asset_id") @db.Uuid
  asset             Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  side              OrderSide
  type              OrderType
  quantity          Decimal     @db.Decimal(38, 18)
  limitPrice        Decimal?    @map("limit_price") @db.Decimal(38, 12)
  status            OrderStatus
  rejectReason      String?     @map("reject_reason")
  /// Cash held in the reserved account for a pending limit buy (USD cents).
  reservedCashMinor BigInt      @default(0) @map("reserved_cash_minor")
  idempotencyKey    String      @map("idempotency_key")
  requestHash       String      @map("request_hash")
  correlationId     String?     @map("correlation_id")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  filledAt          DateTime?   @map("filled_at") @db.Timestamptz(3)
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  trade             Trade?

  @@unique([userId, idempotencyKey])
  @@index([portfolioId, id])
  /// The limit-order matcher scans this.
  @@index([status, type])
  @@map("simulated_orders")
}

/// A simulated execution. Append-only. One per order (no partial fills).
model Trade {
  id                  String            @id @default(uuid(7)) @db.Uuid
  orderId             String            @unique @map("order_id") @db.Uuid
  order               SimulatedOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  portfolioId         String            @map("portfolio_id") @db.Uuid
  portfolio           Portfolio         @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  assetId             String            @map("asset_id") @db.Uuid
  asset               Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  side                OrderSide
  quantity            Decimal           @db.Decimal(38, 18)
  /// Reference price from the market-data snapshot used for the fill.
  price               Decimal           @db.Decimal(38, 12)
  /// Cash that moved, USD cents (buy: rounded up; sell: rounded down).
  notionalMinor       BigInt            @map("notional_minor")
  realizedPnl         Decimal?          @map("realized_pnl") @db.Decimal(38, 8)
  priceProvider       String            @map("price_provider")
  priceTimestamp      DateTime          @map("price_timestamp") @db.Timestamptz(3)
  ledgerTransactionId String            @unique @map("ledger_transaction_id") @db.Uuid
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  executedAt          DateTime          @default(now()) @map("executed_at") @db.Timestamptz(3)

  @@index([portfolioId, id])
  @@map("trades")
}

/// Periodic snapshot for the performance chart.
model PortfolioValuation {
  portfolioId String    @map("portfolio_id") @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  at          DateTime  @db.Timestamptz(3)
  totalValue  Decimal   @map("total_value") @db.Decimal(38, 8)
  /// True if any position was valued with a stale price.
  isStale     Boolean   @map("is_stale")

  @@id([portfolioId, at])
  @@map("portfolio_valuations")
}

model WatchlistItem {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  assetId   String   @map("asset_id") @db.Uuid
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, assetId])
  @@map("watchlist_items")
}
