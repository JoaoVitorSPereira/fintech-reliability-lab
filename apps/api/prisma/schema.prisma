generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Nest 12 apps compile to CommonJS; Prisma 7 defaults to ESM output.
  moduleFormat        = "cjs"
  // Extensionless relative imports: valid for CJS under nodenext, and Jest can resolve them.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// UUIDv7 ids are time-ordered: new rows land at the end of the btree index
// instead of random pages, which keeps inserts cheap as tables grow.

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Always lowercase; enforced by a CHECK constraint in the migration.
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  accounts     Account[]
  transfers    Transfer[]

  @@map("users")
}

enum SessionRevocationReason {
  LOGOUT
  USER_REVOKED
  REFRESH_TOKEN_REUSE

  @@map("session_revocation_reason")
}

/// One login on one device. Refresh tokens rotate inside it.
model Session {
  id              String                   @id @default(uuid(7)) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  user            User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceName      String?                  @map("device_name")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastRefreshedAt DateTime?                @map("last_refreshed_at") @db.Timestamptz(3)
  /// Absolute lifetime: rotation never extends a session past this.
  expiresAt       DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason   SessionRevocationReason? @map("revoked_reason")
  refreshTokens   RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Only the SHA-256 of the token is stored. A database leak doesn't leak
/// usable tokens. Rows are kept after use so reuse can be detected.
model RefreshToken {
  id           String        @id @default(uuid(7)) @db.Uuid
  sessionId    String        @map("session_id") @db.Uuid
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  tokenHash    String        @unique @map("token_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  /// Set when exchanged for a successor.
  rotatedAt    DateTime?     @map("rotated_at") @db.Timestamptz(3)
  /// Set when invalidated without being exchanged (grace re-issue, logout).
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(3)
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces     RefreshToken? @relation("Rotation")

  @@index([sessionId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Ledger (Milestone 3). Money is BIGINT minor units (centavos for BRL).
// The database enforces the invariants with triggers and constraints declared
// in the migration SQL; see docs/adr/0005-double-entry-ledger.md.
// ---------------------------------------------------------------------------

enum AccountKind {
  /// Owned by a user. Can never go negative (CHECK constraint).
  CUSTOMER
  /// Owned by the platform, e.g. "money that entered from outside". May go negative.
  SYSTEM

  @@map("account_kind")
}

model Account {
  id         String          @id @default(uuid(7)) @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  user       User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind       AccountKind
  /// Stable name for system accounts, e.g. "external-funding:BRL".
  systemCode String?         @unique @map("system_code")
  currency   String          @db.Char(3)
  /// Cached SUM(ledger_entries.amount). Maintained only by a trigger.
  balance    BigInt          @default(0)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  entries    LedgerEntry[]
  outgoing   Transfer[]      @relation("TransferFrom")
  incoming   Transfer[]      @relation("TransferTo")

  /// Target of the composite FK that stops an entry's currency differing from its account's.
  @@unique([id, currency])
  @@index([userId])
  @@map("accounts")
}

enum LedgerTransactionKind {
  DEPOSIT
  TRANSFER

  @@map("ledger_transaction_kind")
}

/// One movement of money. Its entries must sum to zero per currency (checked at COMMIT).
model LedgerTransaction {
  id          String                @id @default(uuid(7)) @db.Uuid
  kind        LedgerTransactionKind
  description String
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  entries     LedgerEntry[]
  transfer    Transfer?

  @@map("ledger_transactions")
}

/// Immutable. Positive amount = money into the account.
model LedgerEntry {
  id            String            @id @default(uuid(7)) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String            @map("account_id") @db.Uuid
  currency      String            @db.Char(3)
  account       Account           @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)
  amount        BigInt
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Statement pagination: WHERE account_id = $1 AND id < $cursor ORDER BY id DESC.
  @@index([accountId, id])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Transfers (Milestone 4). The business record of a money movement and its
// idempotency claim. The money itself is in the ledger transaction it points to.
// ---------------------------------------------------------------------------

enum TransferKind {
  /// Between two customer accounts.
  TRANSFER
  /// Simulated money in from outside (no real payment rail).
  SIMULATED_DEPOSIT

  @@map("transfer_kind")
}

/// Immutable audit record. One row per successful request.
model Transfer {
  id                  String            @id @default(uuid(7)) @db.Uuid
  /// Who asked for it. Idempotency keys are scoped per user.
  userId              String            @map("user_id") @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind                TransferKind
  idempotencyKey      String            @map("idempotency_key")
  /// SHA-256 of the canonical request. Same key + different request = error.
  requestHash         String            @map("request_hash")
  fromAccountId       String            @map("from_account_id") @db.Uuid
  fromAccount         Account           @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId         String            @map("to_account_id") @db.Uuid
  toAccount           Account           @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount              BigInt
  currency            String            @db.Char(3)
  description         String
  ledgerTransactionId String            @unique @map("ledger_transaction_id") @db.Uuid
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  /// Request id of the HTTP call that created it, for tracing across logs.
  correlationId       String?           @map("correlation_id")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, idempotencyKey])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

// ---------------------------------------------------------------------------
// Market data (Milestones 5-6). Prices are NUMERIC and travel as strings:
// provider precision is kept, nothing is ever a float in our code.
// Current quotes live in Redis (short-lived); candles are persisted here.
// ---------------------------------------------------------------------------

enum AssetCategory {
  CRYPTO
  STOCK
  /// Exchange-traded funds. SPY/QQQ stand in for the S&P 500 / Nasdaq-100 indices.
  ETF

  @@map("asset_category")
}

model Asset {
  id               String        @id @default(uuid(7)) @db.Uuid
  category         AssetCategory
  symbol           String
  name             String
  /// Currency prices are quoted in (USD; Binance pairs quote in USDT, see ADR 0007).
  quoteCurrency    String        @map("quote_currency")
  logoUrl          String?       @map("logo_url")
  marketCapRank    Int?          @map("market_cap_rank")
  /// Provider identifiers. Null = that provider doesn't cover this asset.
  coingeckoId      String?       @unique @map("coingecko_id")
  binanceSymbol    String?       @unique @map("binance_symbol")
  twelveDataSymbol String?       @unique @map("twelve_data_symbol")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  candles          Candle[]

  @@unique([category, symbol])
  @@map("assets")
}

enum ChartTimeframe {
  M1
  M5
  M15
  H1
  H4
  D1
  W1
  MN1

  @@map("chart_timeframe")
}

/// OHLCV bar as reported by the provider. Times are UTC. Gaps are kept as gaps.
model Candle {
  assetId   String         @map("asset_id") @db.Uuid
  asset     Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timeframe ChartTimeframe
  openTime  DateTime       @map("open_time") @db.Timestamptz(3)
  open      Decimal        @db.Decimal(38, 12)
  high      Decimal        @db.Decimal(38, 12)
  low       Decimal        @db.Decimal(38, 12)
  close     Decimal        @db.Decimal(38, 12)
  volume    Decimal        @db.Decimal(38, 12)
  provider  String
  fetchedAt DateTime       @map("fetched_at") @db.Timestamptz(3)

  @@id([assetId, timeframe, openTime])
  @@map("candles")
}
